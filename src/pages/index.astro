---
import Base from '../layouts/Base.astro';
import { business as b } from '../data/services';
import Photo from '../components/Photo.astro';
import { featured, reviews } from '../data/reviews';
import { faqs } from '../data/faqs';
---
<Base
  title="La Sheida Spa | Facials, Threading & Waxing in Leesburg, VA"
  description="Licensed estheticians in Leesburg, VA. Custom facials, eyebrow threading & tinting, and full-body waxing inside Salon Lofts. Book online or call today."
>
  <div class="contactbar">
    <div class="wrap contactbar__in">
      <p>{b.building}</p>
      <p>
        <a href={b.phoneHref}>Call {b.phone}</a>
        <a href={b.textHref}>Text {b.text}</a>
      </p>
    </div>
  </div>

  <header class="site-head">
    <div class="wrap site-head__in">
      <a class="logo" href="/">
        <img src="/brand/logo-horizontal.svg" alt="La Sheida Spa, home" width="212" height="74" />
      </a>
      <nav aria-label="Main">
        <ul>
          <li><a href="/eyebrow-threading/">Threading</a></li>
          <li><a href="/facials/">Facials</a></li>
          <li><a href="/waxing/">Waxing</a></li>
          <li><a href="/services/">Prices</a></li>
          <li><a href="#visit">Visit</a></li>
        </ul>
      </nav>
      <a class="btn btn--small" href={b.bookUrl}>Book</a>
    </div>
  </header>

  <main id="main">
    <!-- HERO: the thread is the one memorable element -->
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <h1>Eyebrow threading, facials &amp; waxing in Leesburg, Virginia</h1>
          <p class="lede">
            One-on-one appointments with Sheida Jowkar, who has been threading brows for
            more than 35 years. A private studio, unhurried care, and brows that look like yours.
          </p>
          <div class="hero__ctas">
            <a class="btn" href={b.bookUrl}>Book an appointment</a>
            <a class="btn btn--ghost" href={b.textHref}>Text {b.text}</a>
          </div>
          <a class="rating" href={b.reviewsUrl}>
            <span class="stars" aria-hidden="true">★★★★★</span>
            Rated {b.rating} by {b.reviewCount} clients on Google
          </a>
        </div>

        <figure class="hero__photo">
          <div class="arch">
            <Photo name="treatment-bed" eager alt="A made-up facial bed with a soft throw in La Sheida Spa's treatment room" sizes="(min-width: 960px) 34vw, 90vw" />
          </div>
          <svg class="thread" viewBox="0 0 432 532" aria-hidden="true">
            <path pathLength="1000" d="M0 532 V216 A216 216 0 0 1 432 216 V470 C432 520, 470 560, 560 560" />
          </svg>
          <figcaption class="hero__tag">
            <strong>Inside Salon Lofts, Suite 100</strong>
            Village at Leesburg
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- SERVICES: one panel each, the full menus live on the service pages -->
    <section class="services" aria-labelledby="svc-title">
      <div class="wrap">
        <h2 id="svc-title" class="services__title">What Sheida does best</h2>
        <div class="services__grid">
          <article class="svc-panel svc-panel--lead">
            <figure class="beforeafter">
              <div><Photo name="brows-before" alt="An eyebrow before threading: uneven, with stray hairs" sizes="(min-width: 960px) 40vw, 100vw" /><figcaption>Before</figcaption></div>
              <div><Photo name="brows-after" alt="The same eyebrow after threading by Sheida: clean, defined arch" sizes="(min-width: 960px) 40vw, 100vw" /><figcaption>After</figcaption></div>
            </figure>
            <div class="svc-panel__body">
              <h3><a href="/eyebrow-threading/">Eyebrow threading</a></h3>
              <p>A single twisted cotton thread shapes your brows hair by hair. Precise, gentle on sensitive skin, and no wax near your eyes. Lip, chin and full-face threading too.</p>
              <p class="svc-panel__price">From $20</p>
            </div>
          </article>
          <article class="svc-panel">
            <a href="/facials/" class="svc-panel__img" tabindex="-1" aria-hidden="true"><Photo name="facial-equipment" alt="" sizes="(min-width: 960px) 28vw, 100vw" position="40% 50%" /></a>
            <div class="svc-panel__body">
              <h3><a href="/facials/">Facials</a></h3>
              <p>Eight 60-minute facials, from Sheida’s signature custom facial to hydrodermabrasion, RF skin tightening and teen acne care.</p>
              <p class="svc-panel__price">From $140</p>
            </div>
          </article>
          <article class="svc-panel">
            <a href="/waxing/" class="svc-panel__img" tabindex="-1" aria-hidden="true"><Photo name="hands-petals" alt="" sizes="(min-width: 960px) 28vw, 100vw" /></a>
            <div class="svc-panel__body">
              <h3><a href="/waxing/">Waxing</a></h3>
              <p>Gentle face, bikini and full-body waxing in a private room, including Brazilian and French bikini.</p>
              <p class="svc-panel__price">From $10</p>
            </div>
          </article>
        </div>
        <a class="textlink" href="/services/">See the full price list</a>
      </div>
    </section>

    <!-- REVIEWS: verbatim from Google -->
    <section class="reviews" aria-labelledby="r-title">
      <div class="wrap">
        <h2 id="r-title" class="sr-only">Client reviews</h2>
        <figure class="reviews__lead">
          <blockquote><p>{featured.quote}</p></blockquote>
          <figcaption>{featured.name}, {featured.service.toLowerCase()} client</figcaption>
        </figure>
        <ul class="reviews__grid">
          {reviews.map((r) => (
            <li>
              <figure>
                <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
                <blockquote><p>{r.quote}</p></blockquote>
                <figcaption>{r.name} <span>{r.service}</span></figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <a class="textlink" href={b.reviewsUrl}>Read all {b.reviewCount} reviews on Google</a>
      </div>
    </section>

    <!-- DETAILS STRIP -->
    <section class="strip" aria-label="Around the studio">
      <Photo class="strip__a" name="products-shelf" alt="Skincare products and a pump bottle on a wooden shelf" sizes="(min-width: 720px) 40vw, 100vw" />
      <Photo class="strip__b" name="clock-detail" alt="A vintage clock and salt lamp on a shelf in the studio" sizes="(min-width: 720px) 20vw, 50vw" />
      <Photo class="strip__c" name="orchid-diffuser" alt="Reed diffusers and a purple orchid" sizes="(min-width: 720px) 20vw, 50vw" />
      <Photo class="strip__d" name="image-skincare" alt="IMAGE Skincare Vital C and Prevention+ products used at the spa" sizes="(min-width: 720px) 20vw, 100vw" />
    </section>

    <!-- SHEIDA -->
    <section class="sheida" aria-labelledby="s-title">
      <div class="wrap sheida__grid">
        <div class="sheida__photo">
          <Photo name="treatment-room" alt="Treatment room with a facial bed, magnifying lamp and equipment" sizes="(min-width: 960px) 40vw, 100vw" />
        </div>
        <div>
        <h2 id="s-title" class="sheida__statement">
          35 years of threading, 22 years of skincare, and the same person at every appointment.
        </h2>
        <div class="sheida__copy">
          <p>
            Spa director Sheida Jowkar sees every client herself. Appointments are
            one-on-one with a licensed esthetician, in a calm private studio, so you’re
            never passed between rooms or rushed out for the next booking.
          </p>
          <p>
            La Sheida Spa moved in 2026 and is now inside Salon Lofts at the Village at
            Leesburg. Body treatments use organic products only.
          </p>
        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq" aria-labelledby="faq-title">
      <div class="wrap faq__grid">
        <h2 id="faq-title">Questions before your first visit</h2>
        <div class="faq__list">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- VISIT / BOOK -->
    <section class="visit" id="visit" aria-labelledby="v-title">
      <div class="wrap visit__grid">
        <div>
          <h2 id="v-title">Book your visit</h2>
          <p>Book online, or call or text and Sheida will find you a time.</p>
          <div class="hero__ctas">
            <a class="btn btn--light" href={b.bookUrl}>Book an appointment</a>
            <a class="btn btn--ghost-light" href={b.phoneHref}>Call {b.phone}</a>
          </div>
        </div>
        <aside class="visitcard" aria-labelledby="vc-title">
          <h3 id="vc-title">Salon Lofts, Suite 100</h3>
          <address>
            {b.street.replace(', Suite 100', '')}<br />
            {b.city}, {b.region} {b.zip}
          </address>
          <dl class="hours">
            {b.hours.map((h) => (
              <div class={h.open === 'Closed' ? 'is-closed' : ''}>
                <dt>{h.day}</dt><dd>{h.open}</dd>
              </div>
            ))}
          </dl>
          <p class="visitcard__links">
            <a href="https://www.google.com/maps/dir/?api=1&destination=La+Sheida+Spa+1601+Village+Market+Blvd+SE+Leesburg+VA">Get directions</a>
            <a href="/parking/">Parking</a>
          </p>
        </aside>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap site-foot__in">
      <img class="logo--foot" src="/brand/logo-stacked-light.svg" alt="La Sheida Spa" width="150" height="160" loading="lazy" />
      <ul>
        <li><a href="/eyebrow-threading/">Eyebrow threading</a></li>
        <li><a href="/facials/">Facials</a></li>
        <li><a href="/waxing/">Waxing</a></li>
        <li><a href="/services/">Full price list</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
      <ul>
        <li><a href="https://www.instagram.com/">Instagram</a></li>
        <li><a href="https://www.facebook.com/">Facebook</a></li>
        <li><a href="https://www.tiktok.com/">TikTok</a></li>
      </ul>
      <p class="fine">Prices may change without notice. © 2026 La Sheida Spa.</p>
    </div>
  </footer>
</Base>
