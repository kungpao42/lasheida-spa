---
// Responsive photo from public/images/<name>-{800,1600}.webp (imported by scripts/fetch-images.mjs).
interface Props { name: string; alt: string; sizes?: string; class?: string; eager?: boolean; position?: string }
const { name, alt, sizes = '(min-width: 960px) 50vw, 100vw', class: cls, eager = false, position } = Astro.props;
---
<img
  class={cls}
  src={`/images/${name}-1600.webp`}
  srcset={`/images/${name}-800.webp 800w, /images/${name}-1600.webp 1600w`}
  sizes={sizes}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  style={position ? `object-position:${position}` : undefined}
/>
